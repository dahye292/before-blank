# 이 파일을 복사해서 같은 폴더에 .env 로 저장하고 값을 채우세요. .env는 공유·업로드하지 마세요.
# https://platform.claude.com 에서 발급한 API 키 (콘솔에서 월 사용 한도도 꼭 정해 두세요)
ANTHROPIC_API_KEY=

# ---- 내 API 키를 아무나 쓰지 못하게 ----
# 언제나 AI를 쓸 수 있는 계정(나). 쉼표로 여러 개. 가입한 이메일과 똑같이.
AI_OWNER_EMAILS=
# 초대 코드. "코드" 또는 "코드:최대인원" (예: BB-7Q2K9:5 → 5명까지). 쉼표로 여러 개.
# 코드를 지우면 그 코드로 들어온 사람은 바로 AI를 못 써요. 비워 두면 나만 써요.
AI_INVITE_CODES=
# 초대받은 한 사람이 하루에 AI를 부를 수 있는 횟수 (답 1번, 마인드맵 정리 1번이 각각 1회)
AI_DAILY_LIMIT_PER_USER=20
# 초대받은 사람 전체를 합친 하루 한도 (나는 포함하지 않음)
AI_DAILY_LIMIT_INVITED=100

# 비밀번호 찾기 메일 (선택). 비워 두면 재설정 링크를 서버 콘솔에만 남겨요.
# 예: 네이버 메일 smtp.naver.com / 587, 지메일 smtp.gmail.com / 587 (앱 비밀번호 필요)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# 로그인 쿠키 서명용 비밀 키 (배포할 때는 꼭 직접 정하기, 32자 이상). 비우면 data/secret_key 파일을 자동으로 만들어 써요.
# 만들기: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ---- 인터넷에 배포할 때 ----
# 1로 두면: https 전용 쿠키, SECRET_KEY 필수, 프록시 뒤 실제 접속 주소 사용, HSTS
PRODUCTION=
# 배포 모드가 아니어도 프록시 뒤에서 돌릴 때만 1
TRUST_PROXY=
