# 이 파일을 복사해서 같은 폴더에 .env 로 저장하고 값을 채우세요. .env는 공유·업로드하지 마세요.
# https://platform.claude.com 에서 발급한 API 키
ANTHROPIC_API_KEY=

# 비밀번호 찾기 메일 (선택). 비워 두면 재설정 링크를 서버 콘솔에만 남겨요.
# 예: 네이버 메일 smtp.naver.com / 587, 지메일 smtp.gmail.com / 587 (앱 비밀번호 필요)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# 로그인 쿠키 서명용 비밀 키 (배포할 때는 꼭 직접 정하기). 비우면 data/secret_key 파일을 자동으로 만들어 써요.
SECRET_KEY=
